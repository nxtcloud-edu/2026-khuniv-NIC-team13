# Terraform Cloud Configuration
terraform_cloud_organization = "pertino-org"
terraform_cloud_workspace    = "pertino-prod"

# AWS Configuration
aws_region  = "ap-northeast-2"
project_name = "pertino"
environment  = "prod"

# =============================================================================
# Domain & HTTPS Configuration
# =============================================================================
# Setting domain_name enables:
#   1. Route53 A/AAAA records pointing to CloudFront
#   2. ACM certificates (CloudFront: us-east-1, ALB: ap-northeast-2)
#   3. HTTPS support for your custom domain
#
# Flow: User → https://your-domain.com → CloudFront → ALB → ECS
#
domain_name = "khu-pertino-deploy.com"

# Hosted Zone Configuration
# Option A: Create new Hosted Zone (default)
#   - Set create_hosted_zone = true (default)
#   - After apply, update your domain registrar's nameservers with Route53's nameservers
#   - Check: terraform output route53_name_servers
#
# Option B: Use existing Hosted Zone
#   - Set create_hosted_zone = false
#   - Set existing_hosted_zone_id = "Z0XXXXXXXXXX"
#
# create_hosted_zone = true  # Default: creates new Hosted Zone
# existing_hosted_zone_id = ""  # Only needed if create_hosted_zone = false

# ACM Certificate Verification
# After terraform apply:
#   1. Check ACM console → Certificates should show "Issued" status
#   2. If "Pending validation", verify DNS records are created in Route53
#   3. terraform output cloudfront_certificate_arn
#   4. terraform output alb_certificate_arn

# Network Configuration
enable_vpc_endpoints = true
enable_nat_gateway   = true

# Security Configuration
# When true, ALB only accepts traffic from CloudFront (recommended for production)
# Set to false if you need direct ALB access for debugging
restrict_alb_to_cloudfront = true

# Note: This is an example file. Copy to terraform.tfvars and fill in actual values.
# terraform.tfvars should NOT be committed to version control.

