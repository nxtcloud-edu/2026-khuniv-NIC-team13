APP_NAME=AI Rookie Pertineo API
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

SESSION_COOKIE_NAME=PERTINEO_SESSION
SESSION_EXPIRE_MINUTES=30
SESSION_EXTEND_MINUTES=30

ALLOW_ALL_EMAILS=true
ALLOWED_MEMBER_EMAIL_DOMAINS=["khu.ac.kr"]
MEMBER_EMAIL_WHITELIST=[]

# Use disabled only for local development and tests. Use smtp for the MVP or ses later.
EMAIL_DELIVERY_BACKEND=disabled
EMAIL_FROM_ADDRESS=
EMAIL_VERIFICATION_SUBJECT=Pertineo 이메일 인증번호
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_APP_PASSWORD=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

REPOSITORY_BACKEND=memory
AWS_REGION=ap-northeast-2
DYNAMODB_NOTICES_TABLE=pertineo-notices
DYNAMODB_EMAILS_TABLE=pertineo-emails
DYNAMODB_EMAIL_VERIFICATIONS_TABLE=pertineo-email-verifications
DYNAMODB_SESSIONS_TABLE=pertineo-sessions
DYNAMODB_POPUPS_TABLE=pertineo-popups
DYNAMODB_COUNTERS_TABLE=pertineo-counters
