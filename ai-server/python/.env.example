# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and picked up automatically by pydantic-settings.
# Docker Compose currently reads `.env.dev`; copy this template there when
# starting the complete Docker stack.

# --- Application logging ---
LOG_LEVEL=INFO
VERBOSE_LIBS=0

# --- Active profile ---
# local  -> uses DynamoDB Local at DYNAMODB_ENDPOINT, seeds dummy data on startup
# prod   -> uses real AWS endpoints (no endpoint override unless AWS_DYNAMODB_ENDPOINT is set)
SPRING_PROFILES_ACTIVE=local

# --- OpenAI (structured output, resume parsing, and embeddings) ---
# Create python/.env locally and place the real key there. Never commit it.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low

# --- Tavily (web search) ---
TAVILY_API_KEY=

# --- AWS (DynamoDB + S3 Vectors) ---
AWS_REGION=ap-northeast-2
# Only needed if boto3's default credential chain (env vars / shared config /
# instance profile) isn't already set up on this machine:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Include only for temporary AWS credentials.
AWS_SESSION_TOKEN=

# DynamoDB Local endpoint override, used only when SPRING_PROFILES_ACTIVE=local
DYNAMODB_ENDPOINT=http://localhost:8000
# Real DynamoDB endpoint override, used only when SPRING_PROFILES_ACTIVE=prod
# (leave blank to use AWS's default regional endpoint)
AWS_DYNAMODB_ENDPOINT=

AWS_DYNAMODB_TABLE_RESUME_COORDINATES=pertino-resume-coordinates
AWS_DYNAMODB_TABLE_DOCUMENT_CONTEXT=pertineo-document-context

# --- S3 Vectors (similar-resume search) ---
S3_VECTORS_BUCKET=pertineo-data-vector
S3_VECTORS_INDEX=pertineo-data-vector-index

# --- LangSmith (tracing, optional — leave unset to disable tracing) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pertineo-default

# --- Smart parsing (resume text -> question/answer list) ---
SMART_PARSING_PRIMARY_MODEL=gpt-5-nano
SMART_PARSING_FALLBACK_MODEL=gpt-5-mini
SMART_PARSING_FALLBACK_ENABLED=true
SMART_PARSING_FALLBACK_MAX_CHARS=1000
RESUME_FILE_PARSING_MODEL=gpt-5-mini
